# Firebase (usado só no servidor) — chave de conta de serviço do projeto
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Cole a private_key do JSON mantendo os \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Código de acesso da tela de login
ACCESS_CODE=0000
# Segredo para assinar o cookie de sessão
SESSION_SECRET=troque-por-um-valor-aleatorio
